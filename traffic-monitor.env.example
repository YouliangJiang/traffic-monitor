TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me
ADMIN_TOKEN=replace-me
# Agent-only key obtained during enrollment; never use ADMIN_TOKEN on an agent.
# AGENT_TOKEN=replace-me
AGENT_AUTH_FILE=/etc/traffic-monitor-agents.json
ROLE=hub
NODE_NAME=my-node
TRAFFIC_IFACE=eth0
# Optional display name. Empty = NODE_NAME, then hostname.
HOST_LABEL=
BILLING_RESET_DAY=1
# Host local time that day. 08 means 08:00:00. Omit for midnight.
BILLING_RESET_TIME=00:00:00
MONTHLY_CAP_BYTES=2000000000000
# Daily reports are scheduled by traffic-monitor.timer at 00:00 Asia/Singapore.
# Optional passive security provider (requires XrayHoneypot on this host).
# SECURITY_PROVIDER=xray_honeypot
# SECURITY_EVENT_LOG=/var/log/xray-honeypot/events.jsonl
# SECURITY_STATUS_FILE=/var/log/xray-honeypot/status.json
# Hub local geography/ASN data; updated by traffic-ipdata.timer.
# IP_DATA_DIR=/var/lib/traffic-monitor-ipdata
# Optional HTTPS geolocation fallback if the local database is missing.
# IP_CONTEXT_ONLINE=1
HUB_BIND=0.0.0.0
HUB_PORT=8788
HUB_URL=https://127.0.0.1:8788
# Optional public hub URL for agent join hints. Leave empty unless you need it.
FLEET_PUBLIC_URL=
HUB_CA=/var/lib/traffic-monitor/hub.crt
# Bot UI language: zh or en. Telegram 中文/English buttons override this in ui.json.
UI_LANG=zh
