# /etc/traffic-monitor.env (mode 0600). install.sh writes this; do not commit a filled-in copy.
ROLE=hub
NODE_NAME=my-node
# Accounting NIC; install.sh defaults to the default-route interface.
TRAFFIC_IFACE=eth0
# Billing period reset in host local time; MONTHLY_CAP_BYTES=0 means unlimited.
BILLING_RESET_DAY=1
BILLING_RESET_TIME=00:00:00
MONTHLY_CAP_BYTES=2000000000000
# Shared by the hub and every agent.
AGENT_TOKEN=replace-me

# Hub only
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me
HUB_BIND=0.0.0.0
HUB_PORT=8788
DAILY_REPORT_TIME=09:00
OFFLINE_ALERT_SEC=300
DISK_ALERT_PCT=90
MEM_ALERT_PCT=90
# zh or en
UI_LANG=zh

# Agent only
# HUB_URL=https://HUB_HOST:8788
# HUB_FINGERPRINT=sha256-hex-printed-by-the-hub-install
