# Managed by traffic-monitor. Retention for the optional xray-guard observation
# log (empty-connection flood candidates). Rotated by the system logrotate as
# root; missingok covers nodes where xray-guard is not installed.
/var/log/xray-guard/would-block.jsonl {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root root
    su root root
}
