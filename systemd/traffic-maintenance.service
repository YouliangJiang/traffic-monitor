[Unit]
Description=Prune thirty-day security history and idle caches
Requires=traffic-journal-clean.service
After=traffic-journal-clean.service

[Service]
Type=oneshot
User=trafficmon
Group=trafficmon
StateDirectory=traffic-monitor
StateDirectoryMode=0750
WorkingDirectory=/opt/traffic-monitor
ExecStart=/usr/bin/python3 /opt/traffic-monitor/maintenance.py
LogNamespace=traffic-security
Nice=15
CPUQuota=15%
TasksMax=8
MemoryAccounting=yes
MemoryHigh=24M
MemoryMax=48M
MemorySwapMax=0
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
