[Unit]
Description=Rotate and vacuum only the traffic security journal namespace
After=systemd-journald@traffic-security.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/journalctl --namespace=traffic-security --rotate --vacuum-time=30d
LogNamespace=traffic-security
Nice=15
CPUQuota=15%
MemoryMax=32M
MemorySwapMax=0
TasksMax=4
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=-/var/log/journal/%m.traffic-security -/run/log/journal/%m.traffic-security
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_OVERRIDE
