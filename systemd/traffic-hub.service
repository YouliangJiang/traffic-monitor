[Unit]
Description=Traffic fleet hub (inventory, heartbeats, jobs)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trafficmon
Group=trafficmon
EnvironmentFile=/etc/traffic-monitor.env
StateDirectory=traffic-monitor
WorkingDirectory=/opt/traffic-monitor
ExecStart=/usr/bin/python3 -u /opt/traffic-monitor/hub.py
Restart=always
RestartSec=5
Nice=0
CPUQuota=80%
CPUWeight=80
TasksMax=32
MemoryAccounting=yes
MemoryHigh=64M
MemoryMax=96M
MemorySwapMax=96M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectClock=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
KeyringMode=private

[Install]
WantedBy=multi-user.target
